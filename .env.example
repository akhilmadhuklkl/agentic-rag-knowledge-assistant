# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
LOG_LEVEL=INFO
LLM_PROVIDER=deterministic
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=nomic-embed-text
RETRIEVAL_RERANK_WEIGHT=0.08
MINIMUM_LEXICAL_OVERLAP=0.3
WEB_SEARCH_ENABLED=false
WEB_SEARCH_ALLOWED_DOMAINS=
AUDIT_RETENTION_DAYS=30
ADMIN_USER_IDS=
LLM_MODEL=llama3.2
LLM_BASE_URL=http://localhost:11434
EMBEDDING_PROVIDER=local
VECTOR_STORE_PATH=data/vectorstore
DOCUMENT_STORAGE_PATH=data/documents
CONVERSATION_STORE_PATH=data/conversations.json
DATABASE_PATH=data/assistant.db
API_KEY=
WORKSPACE_ID=default
REQUIRE_WORKSPACE_HEADER=false
MAX_UPLOAD_SIZE_BYTES=10000000
MAX_QUESTION_LENGTH=2000
